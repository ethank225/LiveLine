# ---------------------------------------------------------------------------
# Secrets — every file in here is load-bearing. Do not loosen without
# re-confirming what's currently on disk.
# ---------------------------------------------------------------------------

# Dotenv files in any variant, at any depth (backend/.env, frontend/.env.local,
# etc.). `.env.example` stays committable if you ever add one.
.env
.env.*
!.env.example

# Private keys — Kalshi PEMs live at backend/kalshi-*.pem today; also catch
# accidental SSH / cert files.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Anything literally named "secrets" or "credentials" at any depth.
secrets/
credentials/
*.secret
*credentials*.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/
venv/
.venv/
env/

# ---------------------------------------------------------------------------
# Node / Vite (frontend also has its own .gitignore; this is belt-and-suspenders
# in case a root-level install ever happens)
# ---------------------------------------------------------------------------
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.vite/

# ---------------------------------------------------------------------------
# Project-specific generated data
#   (leading `**/` so the match is depth-independent — `backtests/results/`
#    alone only matches relative to this .gitignore's directory.)
# ---------------------------------------------------------------------------
**/backtests/results/

# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Local Claude Code session artifacts, if any ever get written into the repo
# (normally these live under ~/.claude, not in-project).
# ---------------------------------------------------------------------------
.claude/
